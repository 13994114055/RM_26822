@@ -0,0 +1,67 @@
+/*
+ * STM32G4 timer definitions for INAV.
+ */
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#include "platform.h"
+
+#include "common/utils.h"
+
+#include "drivers/io.h"
+#include "drivers/rcc.h"
+#include "drivers/time.h"
+#include "drivers/nvic.h"
+#include "drivers/timer.h"
+#include "drivers/timer_impl.h"
+
+#include "stm32g4xx.h"
+
+const timerDef_t timerDefinitions[HARDWARE_TIMER_DEFINITION_COUNT] = {
+    [TIMER_INDEX(1)]  = { .tim = TIM1,  .rcc = RCC_APB2(TIM1),  .irq = TIM1_CC_IRQn },
+    [TIMER_INDEX(2)]  = { .tim = TIM2,  .rcc = RCC_APB1(TIM2),  .irq = TIM2_IRQn },
+    [TIMER_INDEX(3)]  = { .tim = TIM3,  .rcc = RCC_APB1(TIM3),  .irq = TIM3_IRQn },
+    [TIMER_INDEX(4)]  = { .tim = TIM4,  .rcc = RCC_APB1(TIM4),  .irq = TIM4_IRQn },
+    [TIMER_INDEX(5)]  = { .tim = TIM5,  .rcc = RCC_APB1(TIM5),  .irq = TIM5_IRQn },
+    [TIMER_INDEX(6)]  = { .tim = TIM6,  .rcc = RCC_APB1(TIM6),  .irq = 0 },
+    [TIMER_INDEX(7)]  = { .tim = TIM7,  .rcc = RCC_APB1(TIM7),  .irq = 0 },
+    [TIMER_INDEX(8)]  = { .tim = TIM8,  .rcc = RCC_APB2(TIM8),  .irq = TIM8_CC_IRQn },
+    [TIMER_INDEX(15)] = { .tim = TIM15, .rcc = RCC_APB2(TIM15), .irq = TIM1_BRK_TIM15_IRQn },
+    [TIMER_INDEX(16)] = { .tim = TIM16, .rcc = RCC_APB2(TIM16), .irq = TIM1_UP_TIM16_IRQn },
+    [TIMER_INDEX(17)] = { .tim = TIM17, .rcc = RCC_APB2(TIM17), .irq = TIM1_TRG_COM_TIM17_IRQn },
+    [TIMER_INDEX(20)] = { .tim = TIM20, .rcc = RCC_APB2(TIM20), .irq = TIM20_CC_IRQn },
+};
+
+STATIC_ASSERT(TIMER_INDEX(20) == HARDWARE_TIMER_DEFINITION_COUNT - 1, timer_definition_table_size_mismatch);
+
+uint32_t timerClock(TIM_TypeDef *tim)
+{
+    uint32_t pclk;
+
+    if (tim == TIM1 || tim == TIM8 || tim == TIM15 || tim == TIM16 || tim == TIM17 || tim == TIM20) {
+        pclk = HAL_RCC_GetPCLK2Freq();
+        if (READ_BIT(RCC->CFGR, RCC_CFGR_PPRE2) != 0U) {
+            pclk *= 2U;
+        }
+    }
+    else {
+        pclk = HAL_RCC_GetPCLK1Freq();
+        if (READ_BIT(RCC->CFGR, RCC_CFGR_PPRE1) != 0U) {
+            pclk *= 2U;
+        }
+    }
+
+    return pclk;
+}
+
+_TIM_IRQ_HANDLER(TIM1_CC_IRQHandler, 1);
+_TIM_IRQ_HANDLER(TIM2_IRQHandler, 2);
+_TIM_IRQ_HANDLER(TIM3_IRQHandler, 3);
+_TIM_IRQ_HANDLER(TIM4_IRQHandler, 4);
+_TIM_IRQ_HANDLER(TIM5_IRQHandler, 5);
+_TIM_IRQ_HANDLER(TIM8_CC_IRQHandler, 8);
+_TIM_IRQ_HANDLER(TIM1_BRK_TIM15_IRQHandler, 15);
+_TIM_IRQ_HANDLER(TIM1_UP_TIM16_IRQHandler, 16);
+_TIM_IRQ_HANDLER(TIM1_TRG_COM_TIM17_IRQHandler, 17);
+_TIM_IRQ_HANDLER(TIM20_CC_IRQHandler, 20);
