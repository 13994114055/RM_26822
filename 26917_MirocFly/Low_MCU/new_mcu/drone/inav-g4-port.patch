--- /dev/null
+++ b/src/main/target/link/stm32_flash_g474xg.ld
@@ -0,0 +1,30 @@
+/*
+ * Linker script for STM32G474/G473 (512 KiB flash, 128 KiB SRAM).
+ *
+ * 0x08000000-0x08003FFF  16K vector table and startup code
+ * 0x08004000-0x08007FFF  16K configuration area
+ * 0x08008000-0x0807FFFF 480K firmware
+ */
+
+_Min_Heap_Size = 0;
+_Min_Stack_Size = 0x1800;
+
+ENTRY(Reset_Handler)
+
+MEMORY
+{
+    ITCM_RAM (rwx)     : ORIGIN = 0x10000000, LENGTH = 32K
+
+    FLASH (rx)         : ORIGIN = 0x08000000, LENGTH = 16K
+    FLASH_CONFIG (r)   : ORIGIN = 0x08004000, LENGTH = 16K
+    FLASH1 (rx)        : ORIGIN = 0x08008000, LENGTH = 480K
+
+    RAM (rwx)          : ORIGIN = 0x20000000, LENGTH = 108K
+    CCM (rwx)          : ORIGIN = 0x10003000, LENGTH = 20K
+    MEMORY_B1 (rx)     : ORIGIN = 0x60000000, LENGTH = 0K
+}
+
+REGION_ALIAS("STACKRAM", CCM)
+REGION_ALIAS("FASTRAM", CCM)
+
+INCLUDE "stm32_flash_f7_split.ld"
