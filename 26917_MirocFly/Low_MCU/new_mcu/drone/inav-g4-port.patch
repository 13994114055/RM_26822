+static uartDevice_t *uartFindDevice(uartPort_t *uartPort)
+{
+    for (unsigned i = 0; i < UARTDEV_MAX; i++) {
+        uartDevice_t *pDevice = uartHardwareMap[i];
+        if (pDevice && pDevice->dev == uartPort->USARTx) {
