--- /dev/null
+++ b/src/main/drivers/cmsis_dsp_stubs.c
@@ -0,0 +1,53 @@
+/*
+ * Small scalar fallbacks for the CMSIS DSP primitives used by INAV.
+ * This keeps the STM32G4 target within the 512 KiB flash budget without
+ * pulling in the full CMSIS-DSP transform library.
+ */
+
+#include <math.h>
+#include <stdint.h>
+
+#include "arm_math.h"
+
+void arm_mult_f32(float32_t *pSrcA, float32_t *pSrcB, float32_t *pDst, uint32_t blockSize)
+{
+    for (uint32_t i = 0; i < blockSize; i++) {
+        pDst[i] = pSrcA[i] * pSrcB[i];
+    }
+}
+
+void arm_sub_f32(float32_t *pSrcA, float32_t *pSrcB, float32_t *pDst, uint32_t blockSize)
+{
+    for (uint32_t i = 0; i < blockSize; i++) {
+        pDst[i] = pSrcA[i] - pSrcB[i];
+    }
+}
+
+void arm_scale_f32(float32_t *pSrc, float32_t scale, float32_t *pDst, uint32_t blockSize)
+{
+    for (uint32_t i = 0; i < blockSize; i++) {
+        pDst[i] = pSrc[i] * scale;
+    }
+}
+
+void arm_std_f32(float32_t *pSrc, uint32_t blockSize, float32_t *pResult)
+{
+    if (blockSize == 0U) {
+        *pResult = 0.0f;
+        return;
+    }
+
+    float32_t mean = 0.0f;
+    for (uint32_t i = 0; i < blockSize; i++) {
+        mean += pSrc[i];
+    }
+    mean /= (float32_t)blockSize;
+
+    float32_t variance = 0.0f;
+    for (uint32_t i = 0; i < blockSize; i++) {
+        const float32_t delta = pSrc[i] - mean;
+        variance += delta * delta;
+    }
+
+    *pResult = sqrtf(variance / (float32_t)blockSize);
+}
